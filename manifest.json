{
  "manifest_version": 3,
  "name": "UnDopaUI",
  "version": "0.1.1",
  "description": "X の報酬系をハックする UI を、目的を持って使える静かな UI に変換します。",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "UnDopaUI",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/shared/settings.js", "src/x/content.js"],
      "css": ["src/x/x.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/x/page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
